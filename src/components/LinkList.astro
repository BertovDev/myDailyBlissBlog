---
import { sanityClient } from "sanity:client";
import LinkItem from "./LinkItem.astro";

interface SanityExternalLink {
  _id: string;
  title: string;
  url: string;
  description?: string;
}

const links = await sanityClient.fetch<SanityExternalLink[]>(`
  *[_type == "externalLink" && !(_id in path("drafts.**"))] | order(coalesce(order, 9999) asc, title asc){
    _id, title, url, description
  }
`);
---

{
  links.map((link) => (
    <LinkItem
      title={link.title}
      url={link.url}
      description={link.description ?? ""}
    />
  ))
}
