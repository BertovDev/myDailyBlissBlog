---
import { sanityClient } from "sanity:client";
import BlogItem from "./BlogItem.astro";

interface SanityPost {
  _id: string;
  title: string;
  description?: string;
  publishedAt: string;
  slug: string;
}

const posts = await sanityClient.fetch<SanityPost[]>(`
  *[_type == "post" && !(_id in path("drafts.**")) && defined(slug.current)] | order(publishedAt desc){
    _id, title, description, publishedAt, "slug": slug.current
  }
`);
---

{
  posts.map((post) => (
    <BlogItem
      slug={post.slug}
      title={post.title}
      description={post.description ?? ""}
      pubDate={post.publishedAt}
    />
  ))
}
